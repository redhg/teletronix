{
    "name": "teletronix",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "description": "A retro terminal for interactive fiction and tabletop games",
    "author": "Breon Halling",
    "main": "desktop/main.ts",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "table": "npm run build && vite preview --host",
        "typecheck": "tsc -b",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:quick": "playwright test --project=chromium",
        "test:e2e:ui": "playwright test --ui",
        "lint": "biome check .",
        "format": "biome check --write .",
        "gen": "node scripts/gen.ts",
        "desktop": "vite build && node desktop/run.ts",
        "test:desktop": "vite build && playwright test --config desktop/playwright.config.ts",
        "desktop:build": "npm run build && electron-builder --config desktop/electron-builder.json"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@mantine/core": "^9.6.3",
        "@mantine/hooks": "^9.6.3",
        "@mantine/spotlight": "^9.6.3",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "uqr": "^0.1.3",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@playwright/test": "^1.63.0",
        "@types/node": "^24.13.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "electron": "44.4.5",
        "electron-builder": "26.16.1",
        "opentype.js": "^2.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.1",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^5.0.1"
    }
}
