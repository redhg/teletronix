{
    "name": "teletronix",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "table": "npm run build && vite preview --host",
        "typecheck": "tsc -b",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:quick": "playwright test --project=chromium",
        "test:e2e:ui": "playwright test --ui",
        "lint": "biome check .",
        "format": "biome check --write .",
        "gen": "node scripts/gen.ts"
    },
    "dependencies": {
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@playwright/test": "^1.63.0",
        "@types/node": "^24.13.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.1",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^5.0.1"
    }
}
